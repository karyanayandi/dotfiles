font-family = JetBrainsMono NFM
font-size = 13
cursor-style = block
cursor-style-blink = false
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-theme = ghostty
# GTK's startup-loaded user CSS outranks window-theme. Reload the same palette
# at user priority so tabs, popovers, and accents follow wallpaper changes.
gtk-custom-css = ?/home/karyana/.config/gtk-4.0/colors.css

config-file = ?/home/karyana/.config/theme/generated/ghostty

keybind = ctrl+1=csi:49;5u
keybind = ctrl+2=csi:50;5u
keybind = ctrl+3=csi:51;5u
keybind = ctrl+4=csi:52;5u
keybind = ctrl+5=csi:53;5u
keybind = ctrl+6=csi:54;5u
keybind = ctrl+7=csi:55;5u
keybind = ctrl+8=csi:56;5u
keybind = ctrl+9=csi:57;5u
keybind = ctrl+0=csi:48;5u
