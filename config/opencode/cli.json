{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "image_preview": true,
    "permissions": "autoaccept",
    "markdown": "rendered",
    "verbosity": "medium"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  },
  "tabs": {
    "layout": "horizontal"
  },
  "prompt": {
    "image_preview": true
  },
  "mini": {
    "work_spinner": "block-soft-sweep"
  },
  "keybinds": {
    "prompt.skills": "ctrl+s",
    "session.new": "alt+n",
    "session.tab.close": "alt+q"
  }
}
