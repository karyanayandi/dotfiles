{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "matugen"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "image_preview": true,
    "permissions": "autoaccept"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  },
  "tabs": {
    "layout": "horizontal"
  },
  "prompt": {
    "image_preview": true
  }
}
