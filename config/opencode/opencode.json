{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "compaction": {
    "auto": true
  },
  "lsp": {
    "eslint": {
      "disabled": true
    }
  },
  "model": "9router/oc/deepseek-v4-flash-free",
  "small_model": "9router/oc/deepseek-v4-flash-free",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "coder": {
      "model": "ollama-cloud/deepseek-v4-flash"
    },
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/oc/deepseek-v4-flash-free"
    }
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "local",
      "command": [
        "bash",
        "-c",
        "set -a && source /home/karyana/.env && set +a && exec bunx -y @upstash/context7-mcp"
      ]
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp-oauth"
    },
    "playwriter": {
      "command": ["bun", "x", "playwriter@latest"],
      "enabled": true,
      "type": "local"
    },
    "shadcn": {
      "command": ["bun", "x", "shadcn@latest", "mcp"],
      "enabled": true,
      "type": "local"
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": ["/usr/sbin/codebase-memory-mcp"]
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail",
    "@mohak34/opencode-notifier@latest",
    "@tarquinen/opencode-dcp@latest",
    "context-mode",
    "opencode-goal-plugin",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "ollama": {
      "models": {
        "deepseek-v4-flash:cloud": {
          "name": "deepseek-v4-flash:cloud"
        },
        "deepseek-v4-pro:cloud": {
          "name": "deepseek-v4-fpro:cloud",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "kimi-k2.7-code:cloud": {
          "name": "kimi-k2.7-code:cloud",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "glm-5.2:cloud": {
          "name": "glm-5.1:cloud",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "minimax-m3:cloud": {
          "name": "minimax-m3:cloud",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "qwen3-coder-next:cloud": {
          "name": "qwen3-coder-next:cloud",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "sk-56d3a6bbccf98bff-3qbmu3-2f219179"
      },
      "models": {
        "oc/deepseek-v4-flash-free": {
          "name": "oc/deepseek-v4-flash-free",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
