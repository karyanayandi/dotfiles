{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "compaction": {
    "auto": true
  },
  "model": "openai/gpt-6-sol",
  "agents": {
    "title": {
      "model": "openai/gpt-6-luna"
    },
    "coder": {
      "model": "openai/gpt-6-luna"
    },
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "openai/gpt-6-luna"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "bash",
          "-c",
          "set -a && source /home/karyana/.env && set +a && exec bunx -y @upstash/context7-mcp"
        ]
      },
      "firecrawl": {
        "type": "remote",
        "url": "https://mcp.firecrawl.dev/v2/mcp-oauth"
      },
      "playwriter": {
        "command": [
          "bun",
          "x",
          "playwriter@latest"
        ],
        "type": "local"
      },
      "shadcn": {
        "command": [
          "bun",
          "x",
          "shadcn@latest",
          "mcp"
        ],
        "type": "local"
      },
      "codebase-memory-mcp": {
        "type": "local",
        "command": [
          "/usr/sbin/codebase-memory-mcp"
        ]
      }
    }
  },
  "plugins": [
    "./local-plugins/worktrunk",
    "@tarquinen/opencode-dcp@latest",
    "./local-plugins/context-mode",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "providers": {
    "9router": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "sk-56d3a6bbccf98bff-3qbmu3-2f219179"
      },
      "models": {
        "oc/muse-spark-1.2-contributor-free": {
          "name": "oc/deepseek-v4-flash-free",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}
