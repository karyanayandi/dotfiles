{
  "update": "disable",
  "compaction": {
    "auto": true
  },
  "model": "opencode/muse-spark-1.3-contributor-free",
  "agents": {
    "title": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "coder": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "bash",
          "-c",
          "set -a && source /home/karyana/.env && set +a && exec bunx -y @upstash/context7-mcp"
        ]
      },
      "firecrawl": {
        "type": "remote",
        "url": "https://mcp.firecrawl.dev/v2/mcp-oauth"
      },
      "playwriter": {
        "command": ["bun", "x", "playwriter@latest"],
        "type": "local"
      },
      "shadcn": {
        "command": ["bun", "x", "shadcn@latest", "mcp"],
        "type": "local"
      },
      "codebase-memory-mcp": {
        "type": "local",
        "command": ["/usr/sbin/codebase-memory-mcp"]
      }
    }
  },
  "plugins": [
    "./local-plugins/caveman",
    "./local-plugins/context-mode",
    "./local-plugins/worktrunk",
    "./local-plugins/model-shortcuts",
    "@dietrichgebert/ponytail",
    "@tarquinen/opencode-dcp@latest"
  ],
  "providers": {
    "9router": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "sk-56d3a6bbccf98bff-3qbmu3-2f219179"
      },
      "models": {
        "oc/muse-spark-1.3-contributor-free": {
          "name": "Muse Spark 1.3 Contributor Free",
          "modelID": "oc/muse-spark-1.3-contributor-free",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
