#!/usr/bin/env bash
set -euo pipefail

source=/usr/bin/workmux
cache=${XDG_CACHE_HOME:-$HOME/.cache}/workmux-spinner
mkdir -p "$cache"
chmod 700 "$cache"
temporary=$(mktemp "$cache/.workmux.XXXXXXXX")
trap 'rm -f -- "$temporary"' EXIT
cp -- "$source" "$temporary"

double_frames='⠋⠙⠙⠹⠹⠸⠸⠼⠼⠴⠴⠦⠦⠧⠧⠇⠇⠏⠏⠋'
offsets=$(LC_ALL=C grep -aboF "$double_frames" "$temporary" || true)
if [[ $(head -c 4 "$temporary") != $'\x7fELF' ||
    ! $offsets =~ ^[0-9]+: || $offsets == *$'\n'* ]]; then
    printf '%s\n' 'workmux spinner launcher: unknown workmux spinner layout; /usr/bin/workmux is unchanged' >&2
    exit 1
fi

# Keep Rust string offsets and byte lengths; U+200B has zero display width.
printf '%s\xe2\x80\x8b' ⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏ |
    dd of="$temporary" bs=1 seek="${offsets%%:*}" conv=notrunc status=none
hash=$(sha256sum "$temporary")
target=$cache/${hash%% *}
if ! cmp -s -- "$temporary" "$target"; then
    chmod 700 "$temporary"
    mv -f -- "$temporary" "$target"
fi
rm -f -- "$temporary"
exec -a "$source" "$target" "$@"
