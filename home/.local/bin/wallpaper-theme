#!/usr/bin/env bash
# Generate app colors. Quickshell owns displaying and remembering the wallpaper.
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
cache_home=${XDG_CACHE_HOME:-$HOME/.cache}
if (($# > 2)); then
  echo 'Usage: wallpaper-theme [IMAGE] [color|mono]' >&2
  exit 2
fi
image=${1:-}
mode=${2:-}
store=$cache_home/quickshell/wallpaper
if [[ -f $store ]]; then
  if [[ -z $image ]]; then
    image=$(jq -r 'if type == "object" then .wallpaper // empty else empty end' "$store" 2>/dev/null || head -n 1 "$store")
  fi
  if [[ -z $mode ]]; then
    mode=$(jq -r 'if type == "object" and .monochrome == true then "mono" else "color" end' "$store" 2>/dev/null || echo color)
  fi
fi
mode=${mode:-color}
case $mode in
  monochrome) mode=mono ;;
  color | mono) ;;
  *)
    echo 'wallpaper-theme: mode must be color or mono.' >&2
    exit 2
    ;;
esac
if [[ ! -f $image ]]; then
  echo 'wallpaper-theme: supply an existing wallpaper image, or select one in Quickshell.' >&2
  exit 1
fi
command -v matugen >/dev/null || {
  echo 'wallpaper-theme: install matugen first (sudo pacman -S matugen).' >&2
  exit 1
}
mkdir -p "$cache_home/theme"
# Serialize generation so two wallpaper changes cannot interleave output files.
exec 9>"$cache_home/theme/generate.lock"
flock 9
matugen_args=(--config "$config_home/theme/config.toml" --mode dark --type scheme-tonal-spot --source-color-index 0)
image=$(realpath -- "$image")
if [[ $mode == mono ]]; then
  palette=$(mktemp "$cache_home/theme/monochrome.XXXXXX.json")
  trap 'rm -f -- "$palette"' EXIT
  matugen "${matugen_args[@]}" --dry-run --json hex image "$image" >"$palette"
  python3 - "$palette" <<'PY'
import colorsys
import json
import re
import sys
from pathlib import Path


def rgb(color):
    return [int(color[index : index + 2], 16) / 255 for index in (1, 3, 5)]


def luminance(channels):
    linear = [
        c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in channels
    ]
    return sum(c * weight for c, weight in zip(linear, (0.2126, 0.7152, 0.0722)))


def mono_colors(value):
    if isinstance(value, dict):
        return {key: mono_colors(color) for key, color in value.items()}
    if isinstance(value, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        target = luminance(rgb(value))
        low, high = 0.0, 1.0
        # Match luminance without changing the background hue or saturation.
        for _ in range(24):
            lightness = (low + high) / 2
            channels = colorsys.hls_to_rgb(hue, lightness, saturation)
            if luminance(channels) < target:
                low = lightness
            else:
                high = lightness
        return "#" + bytes(round(c * 255) for c in channels).hex()
    return value


palette = Path(sys.argv[1])
data = json.loads(palette.read_text())
anchor = data["colors"]["background"]["default"]["color"]
if not isinstance(anchor, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", anchor):
    raise ValueError("wallpaper-theme: invalid Matugen terminal background color")
hue, _, saturation = colorsys.rgb_to_hls(*rgb(anchor))
# Use different Matugen tones when generated accents have the same lightness.
for variant in ("dark", "light", "default"):
    dark = variant != "light"
    neutral_tones = (
        (5, 10, 15, 20, 35, 70, 90, 98) if dark else (98, 95, 90, 80, 60, 30, 20, 5)
    )
    for index, tone in enumerate(neutral_tones):
        data["base16"][f"base{index:02x}"][variant]["color"] = data["palettes"][
            "neutral"
        ][str(tone)]["color"]
    tones = (
        (60, 70, 80, 90, 95, 98, 99, 100) if dark else (5, 10, 15, 20, 25, 30, 35, 40)
    )
    for index, tone in enumerate(tones, 8):
        data["base16"][f"base{index:02x}"][variant]["color"] = data["palettes"][
            "primary"
        ][str(tone)]["color"]
    for role, tone in zip(
        ("primary", "secondary", "tertiary"), (80, 90, 95) if dark else (40, 30, 20)
    ):
        data["colors"][role][variant]["color"] = data["palettes"]["primary"][str(tone)][
            "color"
        ]
palette.write_text(json.dumps(mono_colors(data)))
PY
  matugen "${matugen_args[@]}" json "$palette"
else
  matugen "${matugen_args[@]}" image "$image"
fi

# Workmux watches the config directory, not the generated symlink target.
if [[ -f $config_home/workmux/config.yaml ]]; then
  touch -h -- "$config_home/workmux/config.yaml"
fi

# qt5ct/qt6ct watch the directory, not symlinked config/palette targets.
# Creating then removing a temporary entry triggers their 3-second reload timer.
for version in 5 6; do
  qt_dir="$config_home/qt${version}ct"
  if [[ -f $qt_dir/qt${version}ct.conf ]]; then
    notification=$(mktemp "$qt_dir/.matugen-reload.XXXXXX")
    rm -- "$notification"
  fi
done

# GTK's user gtk.css is loaded only once. Named themes reload on a settings change.
# Alternate names once per generation, avoiding a visible fallback-theme flash.
if command -v gsettings >/dev/null; then
  current=$(gsettings get org.gnome.desktop.interface gtk-theme)
  theme=matugen-dark
  [[ $current != "'matugen-dark'" ]] || theme=matugen-dark-alt
  theme_dir="${XDG_DATA_HOME:-$HOME/.local/share}/themes/$theme/gtk-3.0"
  mkdir -p "$theme_dir"
  printf '@import url("file:///usr/share/themes/adw-gtk3-dark/gtk-3.0/gtk.css");\n' >"$theme_dir/gtk.css"
  cat "$config_home/gtk-3.0/colors.css" >>"$theme_dir/gtk.css"
  gsettings set org.gnome.desktop.interface gtk-theme "$theme"
fi

if command -v tmux >/dev/null && tmux list-sessions >/dev/null 2>&1; then
  tmux set-environment -gu FZF_DEFAULT_OPTS
  tmux set-environment -g FZF_DEFAULT_OPTS_FILE "$config_home/theme/generated/fzf.opts"
  THEME_NAME=matugen bash "$HOME/.tmux/theme/theme.tmux"
fi

# Ghostty GTK reloads config and gtk-custom-css. Only signal processes with a handler.
pkill --require-handler --signal USR2 --euid "$UID" --exact ghostty || true

# Update outer terminal and tmux pane palettes before OpenCode re-queries them.
python3 "$config_home/theme/terminal.py"

# OpenCode's system theme re-queries the terminal palette on SIGUSR2.
pkill --require-handler --signal USR2 --euid "$UID" --exact opencode || true

# Reload supported consumers without restarting terminals, shells, or lock screens.
if command -v fish >/dev/null; then
  fish -c 'set -U wallpaper_theme_generation (date +%s%N)'
fi
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null; then
  hyprctl reload >/dev/null || echo 'wallpaper-theme: Hyprland reload failed.' >&2
fi
