{
  "name": "pi-agent-extensions",
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "check": "tsc --noEmit",
    "fmt": "vp fmt --write",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "bun run --workspaces test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "acorn": "^8.18.0",
    "firecrawl": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "^0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "catalog": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@effect/platform-node": "^4.0.0-beta.102",
    "@effect/tsgo": "^0.36.5",
    "@types/node": "^26.2.0",
    "effect": "^4.0.0-beta.102",
    "firecrawl": "^4.37.0",
    "typebox": "^1.3.19",
    "typescript": "^7.0.2",
    "@earendil-works/pi-ai": "0.84.3"
  }
}
