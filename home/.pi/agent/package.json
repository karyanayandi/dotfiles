{
  "name": "pi-agent-extensions",
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "catalog": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@effect/platform-node": "^4.0.0-beta.99",
    "@effect/tsgo": "^0.32.1",
    "@types/node": "^26.1.1",
    "effect": "^4.0.0-beta.99",
    "firecrawl": "^4.30.1",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "check": "tsc --noEmit",
    "fmt": "vp fmt --write",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "bun run --workspaces test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "acorn": "^8.17.0",
    "firecrawl": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "^0.2.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
