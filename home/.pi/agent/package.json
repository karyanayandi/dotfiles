{
  "name": "pi-agent-extensions",
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "type": "module",
  "imports": {
    "#workmux-status": "./extensions/workmux-status.ts"
  },
  "scripts": {
    "check": "tsrs --noEmit && turbo run check",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "node --test tests/workmux-status.test.ts && turbo run test --concurrency=4"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "acorn": "^8.19.0",
    "firecrawl": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yopem/oxlint-config": "^0.7.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsrs": "^0.20.1-ts7.1.0-beta",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^26.6.6",
    "@valibot/to-json-schema": "^1.8.0",
    "firecrawl": "^4.51.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "@earendil-works/pi-ai": "1.4.0"
  }
}
