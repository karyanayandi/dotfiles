{
  "name": "pi-agent-extensions",
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && turbo run check",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "turbo run test --concurrency=4"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.0.3",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "acorn": "^8.18.0",
    "firecrawl": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yopem/oxlint-config": "^0.3.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-tui": "^1.0.3",
    "@types/node": "^26.6.4",
    "@valibot/to-json-schema": "^1.8.0",
    "firecrawl": "^4.42.4",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "@earendil-works/pi-ai": "1.0.3"
  }
}
