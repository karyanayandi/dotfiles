{
  "name": "pi-agent-extensions",
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "check": "tsc --noEmit",
    "fmt": "vp fmt --write",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "bun run --workspaces test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "acorn": "^8.17.0",
    "firecrawl": "^4.30.0",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.24.2",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
