{
  "settings": {
    "mcpFooterStatus": "off"
  },
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "set -a && source /home/karyana/.env && set +a && exec bunx -y @upstash/context7-mcp"
      ],
      "env": {},
      "directTools": true
    },
    "playwriter": {
      "type": "stdio",
      "command": "bunx",
      "args": ["-y", "playwriter@latest"],
      "directTools": true
    },
    "shadcn": {
      "type": "stdio",
      "command": "bunx",
      "args": ["shadcn@latest", "mcp"],
      "directTools": true
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp-oauth",
      "directTools": true
    },
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "/usr/sbin/codebase-memory-mcp",
      "args": [],
      "directTools": true
    }
  }
}
